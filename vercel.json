{
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/application",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/application/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/application/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
